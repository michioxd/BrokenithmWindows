<UserControl
  x:Class="BrokenithmWindows.Views.ControllerSurface"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <Grid
    x:Name="TouchArea"
    Background="#000000"
    MinHeight="180"
    AutomationProperties.Name="Multitouch slider and air controller"
  >
    <Grid.RowDefinitions>
      <RowDefinition x:Name="AirRow" Height="3*" />
      <RowDefinition Height="5*" />
    </Grid.RowDefinitions>
    <Grid x:Name="AirVisual" IsHitTestVisible="False">
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <Grid x:Name="AirBands" Grid.Row="1" />
    </Grid>
    <Grid Grid.Row="1" IsHitTestVisible="False">
      <Grid x:Name="LedStrip" />
      <Grid x:Name="SensorOverlay" />
      <Border
        x:Name="SplitDivider"
        Height="1"
        VerticalAlignment="Center"
        Background="#222222"
        Visibility="Collapsed"
      />
    </Grid>
  </Grid>
</UserControl>
