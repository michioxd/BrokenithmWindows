<Page
  x:Class="BrokenithmWindows.Views.MainPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:BrokenithmWindows.Views"
  MinWidth="800"
  MinHeight="400"
>
  <Page.Resources>
    <Storyboard x:Name="ShowPanelStoryboard">
      <DoubleAnimation
        Storyboard.TargetName="PanelTransform"
        Storyboard.TargetProperty="Y"
        From="500"
        To="0"
        Duration="0:0:0.24"
      >
        <DoubleAnimation.EasingFunction>
          <CubicEase EasingMode="EaseOut" />
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation
        Storyboard.TargetName="Backdrop"
        Storyboard.TargetProperty="Opacity"
        From="0"
        To="1"
        Duration="0:0:0.18"
      />
    </Storyboard>
    <Storyboard x:Name="HidePanelStoryboard">
      <DoubleAnimation
        Storyboard.TargetName="PanelTransform"
        Storyboard.TargetProperty="Y"
        From="0"
        To="500"
        Duration="0:0:0.20"
      >
        <DoubleAnimation.EasingFunction>
          <CubicEase EasingMode="EaseIn" />
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <DoubleAnimation
        Storyboard.TargetName="Backdrop"
        Storyboard.TargetProperty="Opacity"
        From="1"
        To="0"
        Duration="0:0:0.16"
      />
    </Storyboard>
  </Page.Resources>

  <Grid Background="Black">
    <local:ControllerSurface x:Name="Surface" />

    <InfoBar
      Margin="16"
      VerticalAlignment="Bottom"
      IsOpen="{Binding HasError}"
      Severity="Error"
      IsClosable="True"
      Message="{Binding Error}"
    />

    <Grid x:Name="Overlay" Visibility="Collapsed">
      <Rectangle x:Name="Backdrop" Fill="#AA000000" Tapped="BackdropTapped" />
      <Border
        x:Name="FloatingPanel"
        Width="620"
        MaxWidth="620"
        Margin="20,20,20,20"
        HorizontalAlignment="Center"
        VerticalAlignment="Bottom"
        Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
        BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Tapped="PanelTapped"
      >
        <Border.RenderTransform>
          <TranslateTransform x:Name="PanelTransform" Y="800" />
        </Border.RenderTransform>

        <Grid>
          <Grid.Clip>
            <RectangleGeometry Rect="0,0,620,2000" />
          </Grid.Clip>

          <ScrollViewer x:Name="ControlsScrollViewer" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.RenderTransform>
              <TranslateTransform x:Name="ControlsTransform" />
            </ScrollViewer.RenderTransform>
            <StackPanel x:Name="ControlsPanel" Padding="24" Spacing="18">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                  <TextBlock Text="Brokenithm" Style="{ThemeResource TitleTextBlockStyle}" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                      <Run Text="but in Windows -" />
                      <Run Text="{Binding Status}" />
                    </TextBlock>
                  </StackPanel>
                </StackPanel>
                <Button
                  Grid.Column="1"
                  Click="ClosePanelClicked"
                  ToolTipService.ToolTip="Close controls"
                  Padding="8"
                >
                  <FontIcon Glyph="&#xE711;" />
                </Button>
              </Grid>

              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>
                <TextBox
                  Header="Host or IP address"
                  Text="{Binding Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  IsEnabled="{Binding Editable}"
                />
                <NumberBox
                  Grid.Column="1"
                  Header="Port"
                  Value="{Binding Port, Mode=TwoWay}"
                  IsEnabled="{Binding Editable}"
                  Minimum="1"
                  Maximum="65535"
                  SpinButtonPlacementMode="Compact"
                />
                <ComboBox
                  Grid.Column="2"
                  Header="Transport"
                  SelectedIndex="{Binding Mode, Mode=TwoWay}"
                  IsEnabled="{Binding Editable}"
                  HorizontalAlignment="Stretch"
                >
                  <ComboBoxItem Content="UDP" />
                  <ComboBoxItem Content="TCP" />
                </ComboBox>
              </Grid>

              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button
                  Content="Connect / reconnect"
                  Command="{Binding ConnectCommand}"
                  IsEnabled="{Binding Editable}"
                  MinHeight="48"
                  HorizontalAlignment="Stretch"
                  Style="{ThemeResource AccentButtonStyle}"
                />
                <Button
                  Grid.Column="1"
                  Content="Disconnect"
                  Command="{Binding DisconnectCommand}"
                  MinHeight="48"
                  HorizontalAlignment="Stretch"
                />
                <Button
                  Grid.Column="2"
                  Content="Settings"
                  Click="OpenSettings"
                  MinHeight="48"
                  HorizontalAlignment="Stretch"
                />
              </Grid>

              <Border
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="10"
                Padding="16"
              >
                <Grid ColumnSpacing="16">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Spacing="2">
                    <TextBlock Text="Air input" FontWeight="SemiBold" />
                    <TextBlock
                      Text="When off, the slider uses the entire window"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    />
                  </StackPanel>
                  <ToggleSwitch
                    Grid.Column="1"
                    IsOn="{Binding EnableAir, Mode=TwoWay}"
                    OnContent="{x:Null}"
                    OffContent="{x:Null}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Enable air input"
                  />
                </Grid>
              </Border>

              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition />
                  <ColumnDefinition />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button
                  Content="Coin"
                  Command="{Binding CoinCommand}"
                  IsEnabled="{Binding Active}"
                  MinHeight="56"
                  HorizontalAlignment="Stretch"
                />
                <Button
                  Grid.Column="1"
                  Content="Card"
                  Command="{Binding CardCommand}"
                  IsEnabled="{Binding Active}"
                  MinHeight="56"
                  HorizontalAlignment="Stretch"
                />
                <Border
                  x:Name="TestPad"
                  Grid.Column="2"
                  Background="{ThemeResource ControlFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  AutomationProperties.Name="Hold test with touch or mouse"
                >
                  <TextBlock
                    Text="Hold test"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                  />
                </Border>
                <Border
                  x:Name="ServicePad"
                  Grid.Column="3"
                  Background="{ThemeResource ControlFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  AutomationProperties.Name="Hold service with touch or mouse"
                >
                  <TextBlock
                    Text="Hold service"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                  />
                </Border>
              </Grid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding InputStatus}" />
                  <TextBlock
                    Text="{Binding Diagnostics}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  />
                </StackPanel>

                <TextBlock
                  Grid.Column="1"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  VerticalAlignment="Bottom"
                  TextAlignment="Right"
                >
                  <Run Text="{Binding AppVersion}" />
                  <Run Text=" by michioxd - " />
                  <Hyperlink NavigateUri="https://github.com/michioxd/BrokenithmWindows">
                    GitHub
                  </Hyperlink>
                </TextBlock>
              </Grid>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer
            x:Name="SettingsScrollViewer"
            VerticalScrollBarVisibility="Auto"
            Visibility="Collapsed"
          >
            <ScrollViewer.RenderTransform>
              <TranslateTransform x:Name="SettingsTransform" X="-620" />
            </ScrollViewer.RenderTransform>
            <StackPanel
              x:Name="SettingsPanel"
              Padding="24"
              Spacing="20"
              HorizontalAlignment="Stretch"
            >
              <StackPanel Spacing="4">
                <TextBlock Text="Settings" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock
                  Text="Touch mapping and runtime preferences"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                />
              </StackPanel>

              <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8"
                Padding="20"
              >
                <StackPanel Spacing="16">
                  <TextBlock Text="Touch input" Style="{ThemeResource SubtitleTextBlockStyle}" />
                  <ToggleSwitch Header="Enable air area" IsOn="{Binding EnableAir, Mode=TwoWay}" />
                  <ToggleSwitch
                    Header="Simple air (all or none)"
                    IsOn="{Binding SimpleAir, Mode=TwoWay}"
                  />
                  <ToggleSwitch
                    Header="Use contact size"
                    IsOn="{Binding UseContactSize, Mode=TwoWay}"
                  />
                  <TextBlock
                    Text="Contact width is measured as a fraction of controller width. Calibrate it for this tablet because Android size units differ."
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  />
                  <NumberBox
                    Header="Wide contact threshold"
                    Value="{Binding FatThreshold, Mode=TwoWay}"
                    Minimum="0.001"
                    Maximum="1"
                    SmallChange="0.001"
                  />
                  <NumberBox
                    Header="Extra-wide contact threshold"
                    Value="{Binding ExtraFatThreshold, Mode=TwoWay}"
                    Minimum="0.001"
                    Maximum="1"
                    SmallChange="0.001"
                  />
                  <ToggleSwitch
                    Header="Split slider into upper/lower lanes"
                    IsOn="{Binding SplitTouchArea, Mode=TwoWay}"
                  />
                  <TextBlock
                    Text="Each half controls a separate sensor in the same column, so stacked touches remain independent."
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                  />
                </StackPanel>
              </Border>
              <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8"
                Padding="20"
              >
                <StackPanel Spacing="16">
                  <TextBlock Text="Runtime" Style="{ThemeResource SubtitleTextBlockStyle}" />
                  <ToggleSwitch
                    Header="Measure latency"
                    IsOn="{Binding ShowLatency, Mode=TwoWay}"
                  />
                  <ToggleSwitch
                    Header="Keep display awake while connected"
                    IsOn="{Binding KeepScreenOn, Mode=TwoWay}"
                  />
                  <ToggleSwitch
                    Header="Send no-card status"
                    IsOn="{Binding SendEmptyCard, Mode=TwoWay}"
                  />
                </StackPanel>
              </Border>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                <Button
                  Content="Save settings"
                  Command="{Binding SaveCommand}"
                  Style="{ThemeResource AccentButtonStyle}"
                  MinHeight="48"
                />
                <Button Content="Back" Click="CloseSettingsClicked" MinHeight="48" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
